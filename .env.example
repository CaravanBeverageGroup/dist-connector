# Скопировать в .env на VM дистрибьютора и заполнить. Реальные значения в Git не коммитить.

# Адрес сервера приема данных (выдается при подключении)
HUB_URL=https://hub.example.com/api/v1
# Идентификатор и токен дистрибьютора (выдаются при подключении)
DISTRIBUTOR_ID=
DIST_TOKEN=

# Подключение к СУБД 1С (учетная запись только для чтения)
DB_ENGINE=mssql            # mssql | postgres
DB_HOST=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=

# Каталог локального состояния и логов
STATE_DIR=/var/lib/cbg-connector
LOG_LEVEL=INFO
